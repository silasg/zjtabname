layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }
    tab name="Tab 1" {
        pane
        pane {
            plugin location="file:target/wasm32-wasip1/release/zjtabname.wasm"
        }
    }
}
